# --- input data ---
# The restricted workbooks stay out. The synthetic instance and its fitted
# parameters are deliberate exceptions: they contain no Pecan Street series.
*.xlsx
*.xls
!data/raw/indata-synthetic.xlsx
data/raw/*.gdx
!data/raw/.gitkeep

# --- credentials: never commit ---
gamslice.txt
gurobi.lic
*.lic
.env
*_key*

# --- GAMS run artefacts (a listing here can exceed 4 GB) ---
*.lst
*.log
*.lxi
*.gdx
*.g00
225*/
_gams_py_*

# --- Python ---
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
build/
dist/
.ipynb_checkpoints/

# --- generated ---
# Cleaned OUTPUT is a deliberate exception: it is committed so a clean clone
# reproduces every number in the README and in notebooks/00_verification.ipynb
# without a solver, a licence, or the restricted inputs. Everything else here
# is regenerable and stays out.
results/**
!results/.gitkeep
!results/tables/
!results/tables/**/
!results/tables/**/*.csv
!results/tables/*.csv
!results/figures/
!results/figures/*.png
